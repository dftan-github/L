        return 1
    }
    if http_hex_to_i32(String("1A")) != 26 {
        print(String("fail: hex upper"))
        return 1
    }
    if http_hex_to_i32(String("ff")) != 255 {
        print(String("fail: hex ff"))
        return 1
    }
    if http_hex_to_i32(String("")) >= 0 {
        print(String("fail: empty hex should be negative"))
        return 1
    }
    if http_hex_to_i32(String("zz")) >= 0 {
        print(String("fail: invalid hex should be negative"))
        return 1
    }

    // --- Chunked decode: two chunks + terminator ---
    body := String("5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n")
    got := http_dechunk(body)
    if "hello world" != got {
        print(got)
        print(String("fail: chunked decode"))
        return 1
    }

    // Empty chunked body ("0\r\n\r\n" only) yields "".
    if http_dechunk(String("0\r\n\r\n")) != String("") {
        print(String("fail: empty chunked"))
        return 1
    }

    // Truncated chunk (declares 10 bytes, supplies 3) returns what exists.
    trunc := http_dechunk(String("a\r\nabc"))
    if "abc" != trunc {
        print(trunc)
        print(String("fail: truncated chunk should return partial"))
        return 1
    }

    // --- Transfer-Encoding detection ---
    hdr_chunked := String("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n")
    if !http_starts_with_ci(String("Transfer-Encoding: chunked"), String("transfer-encoding:")) {
        print(String("fail: ci prefix"))
        return 1
    }
    if !http_is_chunked(hdr_chunked) {
        print(String("fail: should detect chunked"))
        return 1
    }
    hdr_plain := String("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi")
    if http_is_chunked(hdr_plain) {
        print(String("fail: plain should not be chunked"))
        return 1
    }

    // http_body_auto dechunks transparently.
    if http_body_auto(hdr_chunked) != String("hello") {
        print(http_body_auto(hdr_chunked))
        print(String("fail: body_auto dechunk"))
        return 1
    }
    if http_body_auto(hdr_plain) != String("hi") {
        print(String("fail: body_auto plain"))
        return 1
    }

    // --- PUT reaches the server and the response parses ---
    routes := Map<String>()
    routes.put(String("/item"), String("put_ok"))
    hs := spawn {
        http_serve_once(18194, routes)
    }
    sleep(150)    put_resp := http_put(String("127.0.0.1"), 18194, String("/item"), String("text/plain"), String("v"))
    join(hs)
    if !http_status_ok(put_resp) {
        print(String("fail: put status"))
        return 1
    }
    if http_body(put_resp) != String("put_ok") {
        print(String("fail: put body"))
        return 1
    }

    // --- DELETE verb ---
    routes2 := Map<String>()
    routes2.put(String("/item"), String("deleted"))
    hs2 := spawn {
        http_serve_once(18195, routes2)
    }
    sleep(150)
    del_resp := http_delete(String("127.0.0.1"), 18195, String("/item"))
    join(hs2)
    if !http_status_ok(del_resp) {
        print(String("fail: delete status"))
        return 1
    }
    if http_body(del_resp) != String("deleted") {
        print(String("fail: delete body"))
        return 1
    }

    print(String("http_chunked_ok"))
    return 0
}

//------------------------------------------------
// tests/cases/http_client_test.l
//------------------------------------------------
// P0-1: HTTP client must never hang on a silent peer, must read a body larger
// than one recv chunk, and must support POST.

// Listener that accepts one connection and then says nothing at all.
fun silent_server(i32 port) -> i32 {
    sfd := l_socket_create()
    if l_socket_bind_and_listen(sfd, port) != 0 {
        l_socket_close(sfd)
        return 0 - 1
    }
    cfd := l_socket_accept(sfd)
    if cfd >= 0 {
        l_socket_close(cfd)
    }
    l_socket_close(sfd)
    return 0
}

fun main() -> i32 {
    // --- 1) Timeout: a peer that never replies must not block forever. ---
    hs := spawn {
        silent_server(18191)
    }
    sleep(150)
    t0 := time_now()
    resp := http_get_timeout(String("127.0.0.1"), 18191, String("/silent"), 300)
    elapsed := time_now() - t0
    join(hs)

    if elapsed > 5 {
        print(String("fail: timeout not enforced"))
        return 1
    }
    if resp.length() > 0 {
        print(String("fail: expected empty response from silent peer"))
        return 1
    }
    print(String("timeout_ok"))

    // --- 2) Full response read: status + body must both parse. ---
    routes2 := Map<String>()
    routes2.put(String("/"), String("ok"))
    hs2 := spawn {
        http_serve_once(18192, routes2)
    }
    sleep(150)
    got := http_get(String("127.0.0.1"), 18192, String("/"))
    join(hs2)
    if !http_status_ok(got) {
        print(String("fail: get status"))
        return 1
    }
    if http_body(got) != String("ok") {
        print(String("fail: get body"))
        return 1
    }

    // --- 3) POST carries a body and a content type. ---
    routes3 := Map<String>()
    routes3.put(String("/"), String("posted"))
    hs3 := spawn {
        http_serve_once(18193, routes3)
    }
    sleep(150)
    post := http_post(String("127.0.0.1"), 18193, String("/"), String("text/plain"), String("payload"))
    join(hs3)
    if !http_status_ok(post) {
        print(String("fail: post status"))
        return 1
    }
    if http_body(post) != String("posted") {
        print(String("fail: post body"))
        return 1
    }

    // --- 4) Status code helper. ---
    if http_status_code(post) != 200 {
        print(String("fail: status code"))
        return 1
    }

    // --- 5) Body extraction is exact, not off-by-one. ---
    if http_body(post).length() != 6 {
        print(String("fail: body length"))
        return 1
    }

    print(String("http_client_ok"))
    return 0
}

//------------------------------------------------
// tests/cases/http_parse_test.l
//------------------------------------------------
// Edge cases for the minimal HTTP response parser.
// Each block parses one response and prints the fields under test, so the
// expected output pins the exact behaviour of every branch.

pub fun split_head(String response) -> Array<String> {
    return response.split(13)
}

pub fun parse_status(String response) -> i32 {
    lines := split_head(response)
    if lines.len() == 0 {
        return 0
    }
    line := lines.get(0).trim()
    if line.length() == 0 {
        return 0
    }
    sp := line.index_of(String(" "))
    if sp < 0 {
        return 0
    }
    rest := line.slice(sp + 1, line.length() - sp - 1)
    sp2 := rest.index_of(String(" "))
    if sp2 < 0 {
        return rest.trim().to_i32()
    }
    return rest.slice(0, sp2).trim().to_i32()
}

pub fun parse_headers(String response) -> CPropertys {
    props := CPropertys()
    lines := split_head(response)
    if lines.len() < 2 {
        return props
    }
    i! := 1
    running! := true
    while i < lines.len() && running {
        line := lines.get(i).trim()
        if line.length() == 0 {
            running! = false
        } else {
            colon := line.index_of(String(":"))
            if colon > 0 {
                name := line.slice(0, colon).trim()
                tail := colon + 1
                value := line.slice(tail, line.length() - tail).trim()
                props.set(name, Variant.from_string(value))
            }
            i! = i + 1
        }
    }
    return props
}

pub fun header_text(CPropertys props, String name) -> String {
    hit := props.get(name) ?? Variant.from_string(String(""))
    return hit.as_string() ?? String("")
}

fun main() -> i32 {
    // 1) Normal 200 with two headers
    ok := "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 18\r\n\r\n{\"ok\":true}"
    print(parse_status(ok))
    h1 := parse_headers(ok)
    print(header_text(h1, "Content-Type"))
    print(header_text(h1, "Content-Length"))

    // 2) 404 without Content-Type; missing key must yield ""
    nf := "HTTP/1.1 404 Not Found\r\nServer: L\r\n\r\n"
    print(parse_status(nf))
    print(header_text(parse_headers(nf), "Content-Type"))
    print(header_text(parse_headers(nf), "Server"))

    // 3) Empty response: no status line, no headers
    print(parse_status(""))
    print(header_text(parse_headers(""), "X"))

    // 4) Status line only, no CRLF anywhere
    print(parse_status("HTTP/1.0 500"))

    // 5) ':' inside a header value survives (URL with port)
    col := "HTTP/1.1 201 Created\r\nLocation: http://x/y:8080/z\r\n\r\n"
    print(header_text(parse_headers(col), "Location"))

    // 6) Repeated header: last write wins
    rep := "HTTP/1.1 200 OK\r\nX-A: first\r\nX-A: second\r\n\r\n"
    print(header_text(parse_headers(rep), "X-A"))

    // 7) Whitespace around the name and the value is trimmed
    ws := "HTTP/1.1 200 OK\r\n  X-B  :   padded   \r\n\r\n"
    print(header_text(parse_headers(ws), "X-B"))

    return 0
}

