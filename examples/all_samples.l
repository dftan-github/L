// ============================================================================
// [MODULE] app_host.l
//   The registry/dispatcher. Knows only the IPlugin contract, never the
//   concrete plugins.
//   Depends on: plugin_api, properties (CPropertys), variant (Variant)
//   Declares: class App
// ============================================================================
// BEGIN MODULE app_host

// If this section is moved to app_host.l, uncomment the line below.
// import "plugin_api.l"

class App {
    Array<IPlugin> plugins
    delegate CPropertys

    fun init() {
        plugins = Array<IPlugin>()
        this.set("app_version", "0.1.0")
    }

    pub fun register(IPlugin p) {
        this.plugins.push(p)
    }

    pub fun start_all() {
        for p in this.plugins {
            p.on_start()
        }
    }

    // Chained dispatch straight off the array element — no temp variable.
    pub fun start_one(i32 i) {
        this.plugins.get(i).on_start()
    }

    pub fun name_at(i32 i) -> String {
        return this.plugins.get(i).get_name()
    }

    pub fun plugin_count() -> i32 {
        return this.plugins.len()
    }

    pub fun version() -> String {
        return this.get("app_version") ?? "0.1.0"
    }

    // ------------------------------------------------------------------
    // Tree-shaped properties over dotted paths.
    //
    // Variant only carries scalars (i32 / String / f64 / bool), so a subtree is
    // stored as flattened dotted keys: `db.host`, `db.pool.max`, ... The path
    // segments below walk that virtual tree without materializing nodes.
    // ------------------------------------------------------------------

    // Read a whole subtree as its own flat property bag (keys keep the full path).
    // An empty prefix means the whole tree.
    pub fun subtree(String prefix) -> CPropertys {
        inner := CPropertys()
        top := prefix.length() == 0
        dotted := prefix + "."
        all := this.keys()
        for key in all {
            if top || key.starts_with(dotted) {
                existing := this.get(key)
                if existing.is_some() {
                    inner.set(key, existing.unwrap())
                }
            }
        }
        return inner
    }

    // List the direct child names of a subtree: "db" -> ["host", "port", "pool"].
    // Deeper keys contribute only their next segment, so the result is a tree level.
    pub fun children(String prefix) -> Array<String> {
        out := Array<String>()
        top := prefix.length() == 0
        dotted := prefix + "."
        base := prefix.length() + 1
        all := this.keys()
        i32 n = all.len()
        i32 j = 0
        while j < n {
            key := all.get(j)
            // Root level ("" prefix) lists the first segment of every key.
            if top || key.starts_with(dotted) {
                offset := base
                if top {
                    offset = 0
                }
                rest := key.slice(offset, key.length() - offset)
                dot := rest.index_of(".")
                // First segment only; `dot < 0` means this key is the leaf itself.
                seg_len := rest.length()
                if dot >= 0 {
                    seg_len = dot
                }
                name := rest.slice(0, seg_len)
                if !contains_name(out, name) {
                    out.push(name)
                }
            }
            j = j + 1
        }
        return out
    }

    // Membership test for a name list.
    fun contains_name(Array<String> names, String probe) -> bool {
        i32 i = 0
        while i < names.len() {
            if names.get(i) == probe {
                return true;
            }
            i = i + 1
        }
        return false
    }

    // Render a Variant leaf as text for the dump. Scalars only — Variant has no
    // object tag, so anything unknown falls back to a tag marker.
    pub fun render(Variant v) -> String {
        if v.is_i32() {
            return String.from(v.as_i32() ?? 0)
        }
        if v.is_string() {
            return v.as_string() ?? ""
        }
        if v.is_f64() {
            return str_from_f64(v.as_f64() ?? 0.0)
        }
        if v.is_bool() {
            return str_from_bool(v.as_bool() ?? false)
        }
        return "<unknown>"
    }

    // Recursive dump of a subtree, one "path = value" line per leaf.
    pub fun dump(String prefix) {
        names := this.children(prefix)
        for name in names {
            // Root level must not prepend a leading dot; deeper levels join with one.
            child := name
            if prefix.length() > 0 {
                child = prefix + "." + name
            }
            branch := this.subtree(child)
            if branch.len() == 0 {
                leaf := this.get(child)
                if leaf.is_some() {
                    print("  " + child + " = " + this.render(leaf.unwrap()))
                }
            } else {
                print("  " + child + "/")
                this.dump(child)
            }
        }
    }
}

// END MODULE app_host


// ============================================================================
// [MODULE] plugin_framework.l  (entry point)
//   Wiring only: build the App, register concrete plugins, drive dispatch.
//   Depends on: plugin_api, logger_plugin, auth_plugin, app_host
// ============================================================================
// BEGIN MODULE plugin_framework

// If this section is moved to plugin_framework.l (entry), uncomment the lines below.
// import "plugin_api.l"
// import "logger_plugin.l"
// import "auth_plugin.l"
// import "app_host.l"

fun main() -> i32 {
    app := App()

    print("app version: " + app.version())

    app.register(LoggerPlugin())
    app.register(AuthPlugin())
    print(app.plugin_count())

    app.start_all()

    // Chained: element -> method call, both void and String-returning.
    app.start_one(0)
    print(app.name_at(1))

    for p in app.plugins {
        print(p.get_name())
    }

    // ---- Tree-shaped properties over dotted paths -------------------------
    print("-- config tree --")

    // `set` / `get` are promoted onto App by `delegate CPropertys`. A primitive or
    // String passed to the `Variant` formal is boxed automatically.
    app.set("db.host", "localhost")
    app.set("db.port", 5432)
    app.set("db.pool.max", 16)
    app.set("db.pool.idle", 4)
    app.set("http.timeout", 30)
    app.set("http.retries", 3)

    // Writing the same path again replaces the leaf.
    app.set("http.timeout", 60)

    // `get` returns Optional<Variant>; `??` unwraps it and also unpacks the
    // Variant into the fallback's type, so `?.as_*()` is not needed here.
    print(app.get("db.host") ?? "none")
    print(app.get("db.pool.max") ?? 0)
    print(app.get("db.pool.missing") ?? 8)

    // Direct children of a subtree, one level only.
    print(app.children("db").len())
    print(app.children("db.pool").len())

    // Whole subtree as its own bag (keys keep the full dotted path).
    pool := app.subtree("db.pool")
    print(pool.len())

    // An empty prefix selects the whole tree.
    print(app.subtree("").len())

    // Recursive dump of the whole tree.
    app.dump("")
    return 0
}

// END MODULE plugin_framework

