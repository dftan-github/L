//------------------------------------------------
// tests/cases/coalesce_boxing_test.l
//------------------------------------------------
// Read-side auto-boxing: `Optional<Variant> ?? <primitive|String>`.
// When the left operand is `Optional<Variant>`, a primitive/String fallback is
// implicitly boxed via Variant.from_*, mirroring the write-side `set(...)` sugar.

class Store {
    delegate CPropertys

    fun init() {
        this.set("name", "demo")
        this.set("count", 42)
        this.set("ratio", 1.5)
        this.set("enabled", true)
    }

    pub fun name() -> String {
        return (this.get("name") ?? "fallback").as_string() ?? String("?")
    }

    pub fun count() -> i32 {
        return (this.get("count") ?? 0).as_i32() ?? 0
    }

    pub fun ratio() -> f64 {
        return (this.get("ratio") ?? 0.0).as_f64() ?? 0.0
    }

    pub fun enabled() -> bool {
        return (this.get("enabled") ?? false).as_bool() ?? false
    }

    // Missing key → the fallback must be boxed instead of short-circuiting.
    pub fun missing_name() -> String {
        return (this.get("nope") ?? "unset").as_string() ?? String("?")
    }

    pub fun missing_count() -> i32 {
        return (this.get("nope") ?? 99).as_i32() ?? 0
    }

    pub fun missing_ratio() -> f64 {
        return (this.get("nope") ?? 2.5).as_f64() ?? 0.0
    }

    pub fun missing_enabled() -> bool {
        return (this.get("nope") ?? true).as_bool() ?? false
    }
}

fun main() -> i32 {
    s := Store()
    print(s.name())
    print(s.count())
    print(s.ratio())
    print(s.enabled())
    print(s.missing_name())
    print(s.missing_count())
    print(s.missing_ratio())
    print(s.missing_enabled())

    // Bare Optional<Variant> local, no property indirection.
    opt := Optional<Variant>(false, Variant.from_i32(0))
    print((opt ?? 7).as_i32() ?? 0)
    return 0
}

//------------------------------------------------
// tests/cases/coalesce_expr_pos_test.l
//------------------------------------------------
// `??` on Optional<Variant> in EXPRESSION position (not just `return`).
//
// Regression: the contextual Variant unbox used to switch the builder into a
// side block, so `s := v ?? "x"` / `print(v ?? "x")` emitted the following
// instructions into a block that had already been branched away from — the
// module then failed verification with a stray `sext ptr %coalesce to i32`.

// Return position (the original, already-working path).
fun pick(CPropertys p, String key) -> String {
    return p.get(key) ?? String("RET")
}

// Decl position with an explicit String target.
fun pick_decl(CPropertys p, String key) -> String {
    String s = p.get(key) ?? String("DECL")
    return s
}

// Decl position with a primitive target.
fun pick_int(CPropertys p, String key) -> i32 {
    i32 n = p.get(key) ?? 0 - 1
    return n
}

fun main() -> i32 {
    p := CPropertys()
    p.set("name", "value")
    p.set("count", 42)

    // Return position.
    print(pick(p, "name"))
    print(pick(p, "absent"))

    // Decl position, String payload present and absent.
    print(pick_decl(p, "name"))
    print(pick_decl(p, "absent"))

    // Decl position, primitive payload present and absent.
    print(pick_int(p, "count"))
    print(pick_int(p, "absent"))

    // Expression position: `??` inside a call argument.
    print(p.get("name") ?? String("ARG"))
    print(p.get("absent") ?? String("ARG"))

    // `??` feeding a String concatenation (explicit target keeps the payload a String).
    String text = p.get("name") ?? String("none")
    print(String("concat: ") + text)

    // print(Optional<Variant>) directly: payload when present, blank when absent.
    print(p.get("name"))
    print(p.get("absent"))
    return 0
}

